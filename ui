local ConfigModule = {}
function ConfigModule:Init(folderName)
    self.Folder = folderName or "LibaryLib"
    pcall(function()
        if not isfolder(self.Folder) then
            makefolder(self.Folder)
        end
        if not isfolder(self.Folder .. "/configs") then
            makefolder(self.Folder .. "/configs")
        end
    end)
end
function ConfigModule:Save(name)
    local data = {}
    for flag, value in pairs(LibaryLib._flags) do
        if typeof(value) == "Color3" then
            data[flag] = { _type = "Color3", R = math.floor(value.R * 255), G = math.floor(value.G * 255), B = math.floor(value.B * 255) }
        elseif typeof(value) == "EnumItem" then
            data[flag] = { _type = "EnumItem", Value = tostring(value) }
        else
            data[flag] = value
        end
    end
    local ok, err = pcall(function()
        writefile(self.Folder .. "/configs/" .. name .. ".json", HttpService:JSONEncode(data))
    end)
    return ok, err
end
function ConfigModule:Load(name)
    local ok, raw = pcall(function()
        return readfile(self.Folder .. "/configs/" .. name .. ".json")
    end)
    if not ok then return false, "File not found" end
    local success, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not success then return false, "Invalid JSON" end
    for flag, value in pairs(data) do
        if type(value) == "table" and value._type == "Color3" then
            value = Color3.fromRGB(value.R, value.G, value.B)
        end
        LibaryLib._flags[flag] = value
        if LibaryLib._flagSetters[flag] then
            LibaryLib._flagSetters[flag](value)
        end
    end
    return true
end
function ConfigModule:Delete(name)
    local ok = pcall(function()
        delfile(self.Folder .. "/configs/" .. name .. ".json")
    end)
    return ok
end
function ConfigModule:GetList()
    local configs = {}
    pcall(function()
        local files = listfiles(self.Folder .. "/configs")
        for _, file in ipairs(files) do
            local n = file:match("([^/\\]+)%.json$")
            if n then
                table.insert(configs, n)
            end
        end
    end)
    return configs
end
