function Section:AddToggle(options)
    local name     = options.Name or "Toggle"
    local flag     = options.Flag
    local default  = options.Default or false
    local callback = options.Callback or function() end
    local state = default
    local holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, ELEM_HEIGHT),
        BackgroundTransparency = 1,
        Parent = self.Content,
    })
    local label = Create("TextLabel", {
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, -(ELEM_HEIGHT + 8), 1, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.Text,
        Font = FONT,
        TextSize = FONT_SZ_BODY,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })
    local cbW = IS_MOBILE and 38 or 34
    local cbH = IS_MOBILE and 20 or 18
    local cbBg = Create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, cbW, 0, cbH),
        BackgroundColor3 = Theme.Elevated,
        Parent = holder,
    })
    AddCorner(cbBg, UDim.new(1, 0))
    AddButtonGradient(cbBg)
    local cbStroke = AddStroke(cbBg, Theme.Border, 1)
    local knobSize = cbH - 4
    local knob = Create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 2, 0.5, 0),
        Size = UDim2.new(0, knobSize, 0, knobSize),
        BackgroundColor3 = Theme.TextMuted,
        Parent = cbBg,
    })
    AddCorner(knob, UDim.new(1, 0))
    local clickArea = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = holder,
    })
    local function updateVisual(val, animate)
        if val then
            if animate then
                Tween(cbBg, { BackgroundColor3 = Theme.Accent }, TWEEN_SPEED)
                Tween(knob, { Position = UDim2.new(1, -(knobSize + 2), 0.5, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255) }, TWEEN_SPEED, TWEEN_BOUNCE)
                Tween(label, { TextColor3 = Theme.Text }, TWEEN_FAST)
            else
                cbBg.BackgroundColor3 = Theme.Accent
                knob.Position = UDim2.new(1, -(knobSize + 2), 0.5, 0)
                knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                label.TextColor3 = Theme.Text
            end
        else
            if animate then
                Tween(cbBg, { BackgroundColor3 = Theme.Elevated }, TWEEN_SPEED)
                Tween(knob, { Position = UDim2.new(0, 2, 0.5, 0), BackgroundColor3 = Theme.TextMuted }, TWEEN_SPEED)
                Tween(cbStroke, { Color = Theme.Border }, TWEEN_FAST)
            else
                cbBg.BackgroundColor3 = Theme.Elevated
                knob.Position = UDim2.new(0, 2, 0.5, 0)
                knob.BackgroundColor3 = Theme.TextMuted
                cbStroke.Color = Theme.Border
            end
        end
    end
    clickArea.MouseButton1Click:Connect(function()
        state = not state
        updateVisual(state, true)
        if flag then LibaryLib._flags[flag] = state end
        callback(state)
    end)
    updateVisual(state, false)
    if flag then
        LibaryLib._flags[flag] = state
        LibaryLib._flagSetters[flag] = function(val)
            state = val
            updateVisual(val, true)
            callback(val)
        end
    end
    local control = {}
    function control:Set(val)
        state = val
        updateVisual(val, true)
        if flag then LibaryLib._flags[flag] = val end
        callback(val)
    end
    function control:Get() return state end
    table.insert(self._elements, control)
    return control
end
function Section:AddSlider(options)
    local name     = options.Name or "Slider"
    local flag     = options.Flag
    local min      = options.Min or 0
    local max      = options.Max or 100
    local default  = options.Default or min
    local increment= options.Increment or 1
    local suffix   = options.Suffix or ""
    local callback = options.Callback or function() end
    local value = math.clamp(default, min, max)
    local holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, ELEM_HEIGHT + 18),
        BackgroundTransparency = 1,
        Parent = self.Content,
    })
    local topRow = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        Parent = holder,
    })
    local label = Create("TextLabel", {
        Size = UDim2.new(0.7, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.Text,
        Font = FONT,
        TextSize = FONT_SZ_BODY,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = topRow,
    })
    local valueLabel = Create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0.3, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = tostring(value) .. suffix,
        TextColor3 = Theme.AccentLight,
        Font = FONT_BOLD,
        TextSize = FONT_SZ_SM,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = topRow,
    })
    local trackHeight = IS_MOBILE and 8 or 6
    local track = Create("Frame", {
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.new(0, 0, 0, 26),
        Size = UDim2.new(1, 0, 0, trackHeight),
        BackgroundColor3 = Theme.Elevated,
        Parent = holder,
    })
    AddCorner(track, UDim.new(1, 0))
    local fill = Create("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    AddCorner(fill, UDim.new(1, 0))
    AddButtonGradient(fill)
    local fillGlow = Create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = Theme.AccentLight,
        BackgroundTransparency = 0.3,
        Parent = fill,
    })
    AddCorner(fillGlow, UDim.new(1, 0))
    local interactArea = Create("TextButton", {
        Position = UDim2.new(0, 0, 0, 20),
        Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 24),
        BackgroundTransparency = 1,
        Text = "",
        Parent = holder,
    })
    local sliding = false
    local function updateSlider(inputX)
        local trackAbsPos = track.AbsolutePosition.X
        local trackAbsSize = track.AbsoluteSize.X
        local relX = math.clamp((inputX - trackAbsPos) / trackAbsSize, 0, 1)
        local rawVal = min + (max - min) * relX
        if increment < 1 then
            value = math.clamp(math.floor(rawVal / increment + 0.5) * increment, min, max)
        else
            value = math.clamp(math.floor(rawVal / increment + 0.5) * increment, min, max)
        end
        local percent = (value - min) / (max - min)
        Tween(fill, { Size = UDim2.new(percent, 0, 1, 0) }, TWEEN_FAST)
        if increment % 1 == 0 then
