        end
        MakeDraggable(mobileBtn, mobileBtn)
        local lastTap = 0
        mobileBtn.MouseButton1Click:Connect(function()
            if tick() - lastTap < 0.3 then return end
            lastTap = tick()
            window:Toggle()
            if not window._visible then
                startPulse()
            else
                if pulseConnection then
                    pulseConnection:Disconnect()
                    pulseConnection = nil
                end
                mobileBtn.Size = UDim2.new(0, 48, 0, 48)
            end
        end)
    end
    mainFrame.Size = UDim2.new(0, 0, 0, 0)
    mainFrame.BackgroundTransparency = 1
    task.defer(function()
        Tween(mainFrame, {
            Size = UDim2.new(WIN_SCALE_X, WIN_W, WIN_SCALE_Y, WIN_H),
            BackgroundTransparency = 0.15,
        }, 0.4, TWEEN_BOUNCE)
        task.wait(0.5)
        window:Notify({
            Title = title,
            Content = "UI loaded successfully." .. (IS_MOBILE and " Drag the floating button to reposition." or (" Press " .. toggleKey.Name .. " to toggle.")),
            Type = "Success",
            Duration = 5,
        })
    end)
    table.insert(LibaryLib._windows, window)
    return window
end
return LibaryLib
