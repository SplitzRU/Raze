            keyLabel.Text = "... Press Key ..."
            Tween(inputStroke, { Color = Theme.Accent }, TWEEN_FAST)
            Tween(inputBg, { BackgroundColor3 = Theme.SurfaceAlt }, TWEEN_FAST)
        else
            isListening = false
            keyLabel.Text = boundKey.Name
            Tween(inputStroke, { Color = Theme.Border }, TWEEN_FAST)
            Tween(inputBg, { BackgroundColor3 = Theme.Elevated }, TWEEN_FAST)
        end
    end)
    UserInputService.InputBegan:Connect(function(input, processed)
        if isListening and not processed then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                boundKey = input.KeyCode
                keyLabel.Text = boundKey.Name
                isListening = false
                Tween(inputStroke, { Color = Theme.Border }, TWEEN_FAST)
                Tween(inputBg, { BackgroundColor3 = Theme.Elevated }, TWEEN_FAST)
                if flag then LibaryLib._flags[flag] = boundKey.Name end
                callback(boundKey)
            end
        end
    end)
    if flag then
        LibaryLib._flags[flag] = boundKey.Name
        LibaryLib._flagSetters[flag] = function(val)
            if typeof(val) == "string" then
                pcall(function() boundKey = Enum.KeyCode[val] end)
            elseif typeof(val) == "EnumItem" then
                boundKey = val
            end
            keyLabel.Text = boundKey.Name
            callback(boundKey)
        end
    end
    local control = {}
    function control:Set(newKey)
        if typeof(newKey) == "string" then
            pcall(function() newKey = Enum.KeyCode[newKey] end)
        end
        if typeof(newKey) == "EnumItem" then
            boundKey = newKey
            keyLabel.Text = boundKey.Name
            if flag then LibaryLib._flags[flag] = boundKey.Name end
            callback(boundKey)
        end
    end
    function control:Get() return boundKey end
    table.insert(self._elements, control)
    return control
end
